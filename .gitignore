# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/

# Engine runtime state (reproducible from Markdown + sources)
Scripture Graph/.scripture-engine/database/
Scripture Graph/.scripture-engine/logs/
Scripture Graph/.scripture-engine/cache/
Scripture Graph/.scripture-engine/jobs/
Scripture Graph/.scripture-engine/embeddings/
Scripture Graph/.scripture-engine/quarantine/
Scripture Graph/.scripture-engine/state/engine.lock

# Secrets — never commit
Scripture Graph/.scripture-engine/config/.env
.env

# Obsidian per-device state
Scripture Graph/.obsidian/workspace.json
Scripture Graph/.obsidian/workspace-mobile.json
Scripture Graph/.obsidian/cache/
Scripture Graph/.trash/

# Bulk-downloaded corpora (re-fetchable; URLs + hashes live in the registry)
sources/downloads/conference/
sources/downloads/archive-org/

# Scratch
*.tmp

# Obsidian config at repo root (created if the ROOT folder is opened as a vault
# by mistake; the real vault is the 'Scripture Graph' subfolder)
/.obsidian/
