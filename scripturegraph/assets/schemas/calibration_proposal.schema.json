{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CalibrationProposal",
  "type": "object",
  "required": [
    "notes"
  ],
  "properties": {
    "notes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "note_id",
          "issue_key",
          "issue_title",
          "proposition",
          "observation",
          "interpretation",
          "historical_significance",
          "apologetic_significance",
          "does_not_establish",
          "alternatives",
          "symmetry",
          "weight",
          "summary"
        ],
        "properties": {
          "note_id": {
            "type": "string",
            "maxLength": 200
          },
          "issue_key": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "issue_title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "proposition": {
            "type": "string",
            "minLength": 8,
            "maxLength": 400
          },
          "model_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 160
            },
            "maxItems": 8
          },
          "observation": {
            "type": "string",
            "minLength": 8,
            "maxLength": 3000
          },
          "interpretation": {
            "type": "string",
            "minLength": 4,
            "maxLength": 3000
          },
          "historical_significance": {
            "type": "string",
            "minLength": 4,
            "maxLength": 3000
          },
          "apologetic_significance": {
            "type": "string",
            "minLength": 4,
            "maxLength": 3000
          },
          "does_not_establish": {
            "type": "string",
            "minLength": 4,
            "maxLength": 2000
          },
          "models": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "name",
                "predicts",
                "fit"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 160
                },
                "predicts": {
                  "type": "string",
                  "maxLength": 600
                },
                "fit": {
                  "enum": [
                    "strongly challenged",
                    "some difficulty",
                    "not ruled out",
                    "consistent",
                    "supports"
                  ]
                }
              }
            }
          },
          "alternatives": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": [
                "explanation",
                "status"
              ],
              "properties": {
                "explanation": {
                  "type": "string",
                  "maxLength": 600
                },
                "status": {
                  "enum": [
                    "possible",
                    "plausible",
                    "independently_supported",
                    "ad_hoc"
                  ]
                },
                "why": {
                  "type": "string",
                  "maxLength": 600
                }
              }
            }
          },
          "symmetry": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1500
          },
          "base_rate": {
            "type": "string",
            "maxLength": 1200
          },
          "weight": {
            "type": "object",
            "required": [
              "label",
              "direction",
              "evidence_strength",
              "sentence"
            ],
            "properties": {
              "label": {
                "enum": [
                  "none",
                  "weak",
                  "moderate",
                  "strong"
                ]
              },
              "direction": {
                "enum": [
                  "supports",
                  "challenges",
                  "neutral"
                ]
              },
              "evidence_strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "claim_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "sentence": {
                "type": "string",
                "minLength": 10,
                "maxLength": 900
              }
            }
          },
          "language_fixes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 400
            },
            "maxItems": 10
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4000
          },
          "inspiration": {
            "type": "string",
            "maxLength": 600
          },
          "discriminating_test": {
            "type": "string",
            "maxLength": 900
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 12
    }
  }
}
